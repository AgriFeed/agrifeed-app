{
  "name": "@agrifeed/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK wrapping Soroban calls to the AgriFeedOracle and AgriPriceFloor contracts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.0.1",
    "@stellar/freighter-api": "6.0.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
