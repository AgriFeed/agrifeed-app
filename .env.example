# --- apps/web ---
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_ORACLE_CONTRACT_ID=
# Legacy/demo fallback: one already-deployed, already-initialized
# AgriPriceFloor instance, for continuing to fund/settle/cancel an existing
# deal. AgriPriceFloor is one-instance-per-deal, so this is never used to
# create a new deal, see NEXT_PUBLIC_PRICEFLOOR_WASM_HASH for that.
NEXT_PUBLIC_PRICEFLOOR_CONTRACT_ID=
# The uploaded AgriPriceFloor WASM's hash (`stellar contract deploy
# --wasm-hash`, see agrifeed-contract/docs/testnet-deployment.md step 8).
# Every new deal deploys its own fresh instance from this hash.
NEXT_PUBLIC_PRICEFLOOR_WASM_HASH=
NEXT_PUBLIC_INDEXER_API_URL=http://localhost:4000

# --- services/indexer ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agrifeed?sslmode=disable
INDEXER_API_PORT=4000
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
ORACLE_CONTRACT_ID=
PRICEFLOOR_CONTRACT_ID=

# --- services/node-relayer ---
# Never prefix this with NEXT_PUBLIC_. This key belongs to a node address
# that has already been registered on the oracle via add_node. It must
# never be committed or exposed to any frontend bundle.
NODE_RELAYER_SECRET_KEY=
NODE_RELAYER_SUBMIT_INTERVAL_SECONDS=3600
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
ORACLE_CONTRACT_ID=

# Verified live 2026-09-07, see services/node-relayer/src/adapters/fao.ts.
# This classic query API was unreachable during verification (still
# attempted first, with a short timeout); the adapter falls back to
# FAO's bulk Producer Prices CSV product, which was confirmed live.
FAO_API_BASE_URL=https://fenixservices.fao.org/faostat/api/v1

# Verified live 2026-09-07 by fetching the real PCPS dataflow, its DSD,
# and the CL_PCPS_INDICATOR codelist, see
# services/node-relayer/src/adapters/imf.ts. Dataflow IMF.RES:PCPS.
IMF_API_BASE_URL=https://api.imf.org/external/sdmx/3.0

# Verified live 2026-09-07: this is real and live, but it serves AMIS's
# supply/demand/stocks balance sheets, not prices, for 4 of AgriFeed's 8
# commodities. See services/node-relayer/src/adapters/amis.ts, which
# fetches it for diagnostic logging only and never derives a price from
# it.
AMIS_API_BASE_URL=https://api.data.apps.fao.org/api/v2/bigquery
